				interrupts = < 0x91 0x1 >;
				label = "PCC";
				status = "disabled";
			};
		};
		fmc: spi@7e620000 {
			compatible = "aspeed,spi-controller";
			reg = < 0x7e620000 0xc4 >, < 0x80000000 0x10000000 >;
			reg-names = "ctrl_reg", "spi_mmap";
			interrupts = < 0x27 0x1 >;
			clocks = < &sysclk 0x41 >;
			pinctrl-0 = < &pinctrl_fmc_quad >;
			num-cs = < 0x2 >;
			ast-platform = < 0x406 >;
			ctrl-type = "bspi";
			label = "FMC";
			#address-cells = < 0x1 >;
			#size-cells = < 0x0 >;
			spi-ctrl-caps-mask = < 0xe0e0c >;
			status = "okay";
			fmc_cs0: flash@0 {
				compatible = "jedec,spi-nor";
				reg = < 0x0 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "fmc_cs0";
				write-block-size = < 0x1000 >;
				status = "okay";
				partitions {
					compatible = "fixed-partitions";
					#address-cells = < 0x1 >;
					#size-cells = < 0x1 >;
					boot_partition: partition@0 {
						label = "image-0";
						reg = < 0x0 0x100000 >;
					};
					dfu_partition: partition@1 {
						label = "image-1";
						reg = < 0x0 0x100000 >;
					};
				};
			};
			fmc_cs1: flash@1 {
				compatible = "jedec,spi-nor";
				reg = < 0x1 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "fmc_cs1";
				status = "disabled";
			};
		};
		spi1: spi@7e630000 {
			compatible = "aspeed,spi-controller";
			reg = < 0x7e630000 0xc4 >, < 0x90000000 0x10000000 >;
			reg-names = "ctrl_reg", "spi_mmap";
			interrupts = < 0x41 0x1 >;
			clocks = < &sysclk 0x41 >;
			pinctrl-0 = < &pinctrl_spi1_quad >;
			num-cs = < 0x2 >;
			ast-platform = < 0x406 >;
			ctrl-type = "hspi";
			label = "SPI1";
			#address-cells = < 0x1 >;
			#size-cells = < 0x0 >;
			spi-ctrl-caps-mask = < 0xe0e0c >;
			status = "okay";
			spi1_cs0: flash@0 {
				compatible = "jedec,spi-nor";
				reg = < 0x0 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "spi1_cs0";
				status = "okay";
				re-init-support;
			};
			spi1_cs1: flash@1 {
				compatible = "jedec,spi-nor";
				reg = < 0x1 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "spi1_cs1";
				status = "disabled";
				re-init-support;
			};
		};
		spi2: spi@7e640000 {
			compatible = "aspeed,spi-controller";
			reg = < 0x7e640000 0xc4 >, < 0xb0000000 0x10000000 >;
			reg-names = "ctrl_reg", "spi_mmap";
			interrupts = < 0x42 0x1 >;
			clocks = < &sysclk 0x41 >;
			pinctrl-0 = < &pinctrl_spi2_default &pinctrl_spi2_cs1 &pinctrl_spi2_quad >;
			num-cs = < 0x2 >;
			ast-platform = < 0x406 >;
			ctrl-type = "nspi";
			label = "SPI2";
			#address-cells = < 0x1 >;
			#size-cells = < 0x0 >;
			spi-ctrl-caps-mask = < 0xe0e0c >;
			status = "disabled";
			spi2_cs0: flash@0 {
				compatible = "jedec,spi-nor";
				reg = < 0x0 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "spi2_cs0";
				status = "disabled";
				re-init-support;
