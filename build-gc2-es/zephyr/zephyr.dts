				jedec-id;
				label = "spi2_cs1";
				status = "disabled";
				re-init-support;
			};
			spi2_cs2: flash@2 {
				compatible = "jedec,spi-nor";
				reg = < 0x2 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "spi2_cs2";
				status = "disabled";
			};
			spi2_cs3: flash@3 {
				compatible = "jedec,spi-nor";
				reg = < 0x3 >;
				spi-max-buswidth = < 0x4 >;
				spi-max-frequency = < 0x2faf080 >;
				jedec-id;
				label = "spi2_cs3";
				status = "disabled";
			};
		};
		spim0: spi_monitor_common@7e791000 {
			compatible = "aspeed,spi-monitor-controller";
			reg = < 0x7e791000 0x4000 >;
			aspeed,scu = < &syscon >;
			#address-cells = < 0x1 >;
			#size-cells = < 0x0 >;
			label = "spi_m_common";
			status = "disabled";
			spim1: spi_monitor@1 {
				interrupts = < 0x57 0x1 >;
				reg = < 0x1 >;
				label = "spi_m1";
				allow-cmds;
				read-forbidden-regions;
				write-forbidden-regions;
				status = "disabled";
			};
			spim2: spi_monitor@2 {
				interrupts = < 0x58 0x1 >;
				reg = < 0x2 >;
				label = "spi_m2";
				allow-cmds;
				read-forbidden-regions;
				write-forbidden-regions;
				status = "disabled";
			};
			spim3: spi_monitor@3 {
				interrupts = < 0x59 0x1 >;
				reg = < 0x3 >;
				label = "spi_m3";
				allow-cmds;
				read-forbidden-regions;
				write-forbidden-regions;
				status = "disabled";
			};
			spim4: spi_monitor@4 {
				interrupts = < 0x5a 0x1 >;
				reg = < 0x4 >;
				label = "spi_m4";
				allow-cmds;
				read-forbidden-regions;
				write-forbidden-regions;
				status = "disabled";
			};
		};
		wdt0: wdt_common@7e785000 {
			compatible = "aspeed,ast-watchdog";
			interrupts = < 0x18 0x1 >;
			reg = < 0x7e785000 0x200 >;
			#address-cells = < 0x1 >;
			#size-cells = < 0x0 >;
			label = "wdt0";
			status = "okay";
			wdt1: wdt@1 {
				reg = < 0x1 >;
				aspeed,scu = < &syscon >;
				reset-mask = < 0x30f1ff1 0x3fffff1 >;
				label = "wdt1";
				status = "okay";
			};
			wdt2: wdt@2 {
				reg = < 0x2 >;
				aspeed,scu = < &syscon >;
				reset-mask = < 0x30f1ff1 0x3fffff1 >;
				label = "wdt2";
				status = "okay";
			};
			wdt3: wdt@3 {
				reg = < 0x3 >;
				aspeed,scu = < &syscon >;
				reset-mask = < 0x30f1ff1 0x3fffff1 >;
				label = "wdt3";
				status = "okay";
			};
			wdt4: wdt@4 {
				reg = < 0x4 >;
				aspeed,scu = < &syscon >;
				reset-mask = < 0x30f1ff1 0x3fffff1 >;
				label = "wdt4";
				status = "okay";
			};
		};
		i3c: bus@7e7a0000 {
			compatible = "simple-bus";
			#address-cells = < 0x1 >;
			#size-cells = < 0x1 >;
			ranges = < 0x0 0x7e7a0000 0x8000 >;
			i3c_gr: i3c-global-regs@0 {
				compatible = "aspeed,i3c-global";
				#address-cells = < 0x1 >;
				#size-cells = < 0x0 >;
				reg = < 0x0 0x100 >;
				resets = < &sysrst 0x505407 >;
				ni3cs = < 0x4 >;
				status = "okay";
				pull-up-resistor-ohm = < 0x7d0 >, < 0x7d0 >, < 0x7d0 >, < 0x7d0 >, < 0x7d0 >, < 0x7d0 >;
			};
			i3c0: i3c0@2000 {
				compatible = "aspeed,i3c";
				#address-cells = < 0x1 >;
				#size-cells = < 0x0 >;
				reg = < 0x2000 0x1000 >;
				interrupts = < 0x66 0x0 >;
				resets = < &sysrst 0x505408 >;
				clocks = < &sysclk 0x28 >;
				i2c-scl-hz = < 0xf4240 >;
				i3c-scl-hz = < 0xbebc20 >;
				i3c-pp-scl-hi-period-ns = < 0x28 >;
				i3c-pp-scl-lo-period-ns = < 0x28 >;
				i3c-od-scl-hi-period-ns = < 0x17c >;
				i3c-od-scl-lo-period-ns = < 0x26c >;
				sda-tx-hold-ns = < 0xa >;
				instance-id = < 0x0 >;
				pinctrl-0 = < &pinctrl_hvi3c0_default >;
				status = "disabled";
				label = "I3C_0";
			};
			i3c1: i3c1@3000 {
				compatible = "aspeed,i3c";
				#address-cells = < 0x1 >;
				#size-cells = < 0x0 >;
				reg = < 0x3000 0x1000 >;
				interrupts = < 0x67 0x0 >;
				resets = < &sysrst 0x505409 >;
				clocks = < &sysclk 0x29 >;
				i2c-scl-hz = < 0xf4240 >;
				i3c-scl-hz = < 0xbebc20 >;
				i3c-pp-scl-hi-period-ns = < 0x28 >;
				i3c-pp-scl-lo-period-ns = < 0x28 >;
				i3c-od-scl-hi-period-ns = < 0x17c >;
				i3c-od-scl-lo-period-ns = < 0x26c >;
				sda-tx-hold-ns = < 0xa >;
				instance-id = < 0x1 >;
				pinctrl-0 = < &pinctrl_hvi3c1_default >;
				status = "disabled";
				label = "I3C_1";
			};
			i3c2: i3c2@4000 {
				compatible = "aspeed,i3c";
				#address-cells = < 0x1 >;
				#size-cells = < 0x0 >;
				reg = < 0x4000 0x1000 >;
				interrupts = < 0x68 0x0 >;
				resets = < &sysrst 0x50540a >;
				clocks = < &sysclk 0x2a >;
				i2c-scl-hz = < 0xf4240 >;
				i3c-scl-hz = < 0xbebc20 >;
				i3c-pp-scl-hi-period-ns = < 0x28 >;
				i3c-pp-scl-lo-period-ns = < 0x28 >;
				i3c-od-scl-hi-period-ns = < 0x17c >;
				i3c-od-scl-lo-period-ns = < 0x26c >;
				sda-tx-hold-ns = < 0xa >;
				instance-id = < 0x2 >;
				status = "disabled";
				label = "I3C_2";
			};
			i3c3: i3c3@5000 {
				compatible = "aspeed,i3c";
				#address-cells = < 0x1 >;
				#size-cells = < 0x0 >;
				reg = < 0x5000 0x1000 >;
				interrupts = < 0x69 0x0 >;
				resets = < &sysrst 0x50540b >;
				clocks = < &sysclk 0x2b >;
				i2c-scl-hz = < 0xf4240 >;
				i3c-scl-hz = < 0x4c4b40 >;
				i3c-pp-scl-hi-period-ns = < 0x64 >;
				i3c-pp-scl-lo-period-ns = < 0x64 >;
				i3c-od-scl-hi-period-ns = < 0x17c >;
				i3c-od-scl-lo-period-ns = < 0x26c >;
				sda-tx-hold-ns = < 0xa >;
				instance-id = < 0x3 >;
				status = "okay";
				label = "I3C_3";
				assigned-address = < 0x11 >;
				pinctrl-0 = < &pinctrl_i3c3_default >;
			};
		};
		hace: hace@7e6d0000 {
			compatible = "aspeed,hace";
			#address-cells = < 0x1 >;
			#size-cells = < 0x1 >;
			reg = < 0x7e6d0000 0x200 0x7e6f2800 0x10 >;
			clocks = < &sysclk 0xd >;
			resets = < &sysrst 0x404404 >;
		};
		rng: hwrng@7e6e2530 {
			compatible = "aspeed,hwrng";
			reg = < 0x7e6e2530 0x10 >;
			label = "RNG";
		};
		sbc: sbc@7e6f2000 {
			reg = < 0x7e6f2000 0x100 0x79000000 0x2400 >;
			rsa: rsa {
				compatible = "aspeed,rsa";
				clocks = < &sysclk 0x26 >;
				label = "RSA";
			};
			ecdsa: ecdsa {
				compatible = "aspeed,ecdsa";
				label = "ECDSA";
			};
			otp: otp {
				compatible = "aspeed,otp";
				otpcfg;
				otpstrap;
			};
		};
	};
	cpus {
		#address-cells = < 0x1 >;
		#size-cells = < 0x0 >;
		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m4f";
			reg = < 0x0 >;
		};
	};
	sram0: memory@0 {
		compatible = "mmio-sram";
		reg = < 0x0 0x70000 >, < 0x70000 0x50000 >;
	};
};
