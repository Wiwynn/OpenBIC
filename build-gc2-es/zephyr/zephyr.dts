				};
				pinctrl_passthrough1_default: passthrough1_default {
				};
				pinctrl_passthrough2_default: passthrough2_default {
				};
				pinctrl_passthrough3_default: passthrough3_default {
				};
			};
		};
		adc0: adc@7e6e9000 {
			compatible = "aspeed,adc";
			reg = < 0x7e6e9000 0x100 >;
			clocks = < &adc_clk >;
			resets = < &sysrst 0x505417 >;
			interrupts = < 0x2e 0x1 >;
			#io-channel-cells = < 0x1 >;
			aspeed,scu = < &syscon >;
			aspeed,trim-data-locate = < 0x5bc 0x3c000 >;
			label = "ADC0";
			status = "okay";
			pinctrl-0 = < &pinctrl_adc0_default &pinctrl_adc1_default &pinctrl_adc2_default &pinctrl_adc3_default &pinctrl_adc4_default &pinctrl_adc5_default &pinctrl_adc6_default &pinctrl_adc7_default >;
		};
		adc1: adc@7e6e9100 {
			compatible = "aspeed,adc";
			reg = < 0x7e6e9100 0x100 >;
			clocks = < &adc_clk >;
			resets = < &sysrst 0x505417 >;
			interrupts = < 0x2e 0x1 >;
			#io-channel-cells = < 0x1 >;
			aspeed,scu = < &syscon >;
			aspeed,trim-data-locate = < 0x5d0 0xf00 >;
			label = "ADC1";
			status = "okay";
			pinctrl-0 = < &pinctrl_adc8_default &pinctrl_adc9_default &pinctrl_adc10_default &pinctrl_adc11_default &pinctrl_adc12_default &pinctrl_adc13_default &pinctrl_adc14_default &pinctrl_adc15_default >;
		};
		pwm_tach: pwm_tach@7e610000 {
			reg = < 0x7e610000 0x100 >;
			pwm: pwm {
				compatible = "aspeed,pwm";
				#pwm-cells = < 0x3 >;
				npwms = < 0x10 >;
				clocks = < &sysclk 0x41 >;
				resets = < &sysrst 0x505405 >;
				label = "PWM";
				status = "disabled";
			};
			tach: tach {
				compatible = "aspeed,tach";
				#address-cells = < 0x1 >;
				#size-cells = < 0x0 >;
				clocks = < &sysclk 0x41 >;
				resets = < &sysrst 0x505405 >;
				interrupts = < 0x2c 0x1 >;
				label = "TACH";
				status = "disabled";
			};
		};
		gpio0: gpio@7e780000 {
			compatible = "aspeed,gpio";
			reg = < 0x7e780000 0x400 >;
			interrupts = < 0xb 0x1 >;
			clocks = < &sysclk 0x40 >;
			gpio0_a_d: gpio0_a_d {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				gpio-reserved = < 0x0 >;
				label = "GPIO0_A_D";
				pin-offset = < 0x0 >;
				aspeed,persist-maps = < 0x8000000 >;
			};
			gpio0_e_h: gpio0_e_h {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				gpio-reserved = < 0x0 >;
				label = "GPIO0_E_H";
				pin-offset = < 0x20 >;
			};
			gpio0_i_l: gpio0_i_l {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				gpio-reserved = < 0x0 >;
				label = "GPIO0_I_L";
				pin-offset = < 0x40 >;
			};
			gpio0_m_p: gpio0_m_p {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				gpio-reserved = < 0xc0 >;
				label = "GPIO0_M_P";
				pin-offset = < 0x60 >;
			};
			gpio0_q_t: gpio0_q_t {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				gpio-reserved = < 0xf9f3e0 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				label = "GPIO0_Q_T";
				pin-offset = < 0x80 >;
			};
			gpio0_u_v: gpio0_u_v {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x8 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				gpio-reserved = < 0x0 >;
				label = "GPIO0_U_V";
				pin-offset = < 0xa0 >;
			};
		};
		sgpiom: sgpiom@7e780500 {
			compatible = "aspeed,sgpiom";
			reg = < 0x7e780500 0x100 >;
			interrupts = < 0x33 0x1 >;
			clocks = < &sysclk 0x40 >;
			pinctrl-0 = < &pinctrl_sgpiom_default >;
			ngpios = < 0x80 >;
			status = "disabled";
			sgpiom_a_d: sgpiom_a_d {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				label = "SGPIOM_A_D";
				pin-offset = < 0x0 >;
			};
			sgpiom_e_h: sgpiom_e_h {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				label = "SGPIOM_E_H";
				pin-offset = < 0x20 >;
			};
			sgpiom_i_l: sgpiom_i_l {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				label = "SGPIOM_I_L";
				pin-offset = < 0x40 >;
			};
			sgpiom_m_p: sgpiom_m_p {
				#gpio-cells = < 0x2 >;
				gpio-controller;
				ngpios = < 0x20 >;
				interrupt-controller;
				#interrupt-cells = < 0x2 >;
				label = "SGPIOM_M_P";
				pin-offset = < 0x60 >;
			};
		};
		peci: peci@7e78b000 {
			compatible = "aspeed,peci";
			reg = < 0x7e78b000 0x100 >;
			interrupts = < 0x26 0x1 >;
			clocks = < &sysclk 0x41 >;
			resets = < &sysrst 0x505404 >;
			label = "PECI";
			#address-cells = < 0x1 >;
			#size-cells = < 0x0 >;
		};
		jtag0: jtag@7e6e4000 {
			compatible = "aspeed,jtag";
			reg = < 0x7e6e4000 0x20 >;
			interrupts = < 0x1b 0x1 >;
			clocks = < &sysclk 0x41 >;
			resets = < &sysrst 0x50541a >;
			label = "JTAG0";
			pinctrl-0 = < &pinctrl_jtagm0_default >;
			status = "disabled";
		};
		jtag1: jtag@7e6e4100 {
			compatible = "aspeed,jtag";
			reg = < 0x7e6e4100 0x20 >;
			interrupts = < 0x35 0x1 >;
			clocks = < &sysclk 0x41 >;
			resets = < &sysrst 0x505416 >;
			label = "JTAG1";
			pinctrl-0 = < &pinctrl_jtagm1_default >;
			status = "okay";
		};
		timers: timers@7e782000 {
			compatible = "aspeed,timers";
			reg = < 0x7e782000 0x100 >;
			timer0: timer0 {
				compatible = "aspeed,timer";
				interrupts = < 0x10 0x1 >;
				clocks = < &sysclk 0x40 >;
				label = "TIMER0";
				index = < 0x0 >;
				status = "disabled";
			};
			timer1: timer1 {
				compatible = "aspeed,timer";
				interrupts = < 0x11 0x1 >;
				clocks = < &sysclk 0x40 >;
				label = "TIMER1";
				index = < 0x1 >;
				status = "disabled";
			};
			timer2: timer2 {
				compatible = "aspeed,timer";
				interrupts = < 0x12 0x1 >;
				clocks = < &sysclk 0x40 >;
				label = "TIMER2";
				index = < 0x2 >;
				status = "disabled";
			};
			timer3: timer3 {
				compatible = "aspeed,timer";
				interrupts = < 0x13 0x1 >;
				clocks = < &sysclk 0x40 >;
				label = "TIMER3";
				index = < 0x3 >;
				status = "disabled";
			};
			timer4: timer4 {
				compatible = "aspeed,timer";
				interrupts = < 0x14 0x1 >;
				clocks = < &sysclk 0x40 >;
				label = "TIMER4";
				index = < 0x4 >;
				status = "disabled";
