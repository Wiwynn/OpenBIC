/dts-v1/;

/ {
	#address-cells = < 0x1 >;
	#size-cells = < 0x1 >;
	model = "Aspeed AST1030 Evaluation board";
	compatible = "aspeed,bic-ast1030", "aspeed,ast1030";
	chosen {
		zephyr,console = &uart5;
		zephyr,shell-uart = &uart5;
		zephyr,sram = &sram0;
		zephyr,flash = &fmc_cs0;
		zephyr,entropy = &rng;
	};
	aliases {
	};
	soc {
		#address-cells = < 0x1 >;
		#size-cells = < 0x1 >;
		compatible = "simple-bus";
		interrupt-parent = < &nvic >;
		ranges;
		nvic: interrupt-controller@e000e100 {
			compatible = "arm,v7m-nvic";
			reg = < 0xe000e100 0xc00 >;
			interrupt-controller;
			#interrupt-cells = < 0x2 >;
			arm,num-irq-priority-bits = < 0x3 >;
			phandle = < 0x1 >;
		};
		systick: timer@e000e010 {
			compatible = "arm,armv7m-systick";
			reg = < 0xe000e010 0x10 >;
		};
		syscon: syscon@7e6e2000 {
			reg = < 0x7e6e2000 0x1000 >;
			phandle = < 0x5 >;
			sysclk: sysclk {
				compatible = "aspeed,ast10x0-clk";
				#clock-cells = < 0x1 >;
				label = "SYSCLK";
				phandle = < 0x2 >;
				adc_clk: adc_clk {
					#clock-cells = < 0x0 >;
					compatible = "fixed-factor-clock";
					clocks = < &sysclk 0x40 >;
					clock-mult = < 0x1 >;
					clock-div = < 0x2 >;
					label = "ADC_CLK";
					phandle = < 0x3 >;
				};
			};
			sysrst: sysrst {
				compatible = "aspeed,aspeed-rst";
				#reset-cells = < 0x1 >;
				label = "SYSRST";
				phandle = < 0x4 >;
			};
			pinmux: pinmux {
				compatible = "aspeed,pinmux";
				label = "PINMUX";
				pinctrl_adc0_default: adc0_default {
					phandle = < 0x6 >;
				};
				pinctrl_adc1_default: adc1_default {
					phandle = < 0x7 >;
				};
				pinctrl_adc2_default: adc2_default {
					phandle = < 0x8 >;
				};
				pinctrl_adc3_default: adc3_default {
					phandle = < 0x9 >;
				};
				pinctrl_adc4_default: adc4_default {
					phandle = < 0xa >;
				};
				pinctrl_adc5_default: adc5_default {
					phandle = < 0xb >;
				};
				pinctrl_adc6_default: adc6_default {
					phandle = < 0xc >;
				};
				pinctrl_adc7_default: adc7_default {
					phandle = < 0xd >;
				};
				pinctrl_adc8_default: adc8_default {
					phandle = < 0xe >;
				};
				pinctrl_adc9_default: adc9_default {
					phandle = < 0xf >;
				};
				pinctrl_adc10_default: adc10_default {
					phandle = < 0x10 >;
				};
				pinctrl_adc11_default: adc11_default {
					phandle = < 0x11 >;
				};
				pinctrl_adc12_default: adc12_default {
					phandle = < 0x12 >;
				};
				pinctrl_adc13_default: adc13_default {
					phandle = < 0x13 >;
				};
				pinctrl_adc14_default: adc14_default {
					phandle = < 0x14 >;
				};
				pinctrl_adc15_default: adc15_default {
					phandle = < 0x15 >;
				};
				pinctrl_i2c0_default: i2c0_default {
					phandle = < 0x25 >;
				};
				pinctrl_i2c1_default: i2c1_default {
					phandle = < 0x26 >;
				};
				pinctrl_i2c2_default: i2c2_default {
					phandle = < 0x27 >;
				};
				pinctrl_i2c3_default: i2c3_default {
					phandle = < 0x28 >;
				};
				pinctrl_i2c4_default: i2c4_default {
					phandle = < 0x29 >;
				};
				pinctrl_i2c5_default: i2c5_default {
					phandle = < 0x2a >;
				};
				pinctrl_i2c6_default: i2c6_default {
					phandle = < 0x2b >;
				};
				pinctrl_i2c7_default: i2c7_default {
					phandle = < 0x2c >;
				};
				pinctrl_i2c8_default: i2c8_default {
					phandle = < 0x2d >;
				};
				pinctrl_i2c9_default: i2c9_default {
					phandle = < 0x2e >;
				};
				pinctrl_i2c10_default: i2c10_default {
					phandle = < 0x2f >;
				};
				pinctrl_i2c11_default: i2c11_default {
					phandle = < 0x30 >;
				};
				pinctrl_i2c12_default: i2c12_default {
					phandle = < 0x31 >;
				};
				pinctrl_i2c13_default: i2c13_default {
					phandle = < 0x32 >;
				};
				pinctrl_arm_ice_default: arm_ice_default {
				};
				pinctrl_jtagm0_default: jtagm0_default {
					phandle = < 0x17 >;
				};
				pinctrl_jtagm1_default: jtagm1_default {
					phandle = < 0x18 >;
				};
				pinctrl_pwm0_default: pwm0_default {
				};
				pinctrl_pwm1_default: pwm1_default {
				};
				pinctrl_pwm2_default: pwm2_default {
				};
				pinctrl_pwm3_default: pwm3_default {
