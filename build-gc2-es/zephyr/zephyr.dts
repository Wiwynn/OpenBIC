				pinctrl_spim3_muxsel: spim3_muxsel {
				};
				pinctrl_spim4_cs: spim4_cs {
				};
				pinctrl_spim4_in_default: spim4_in_default {
				};
				pinctrl_spim4_out_default: spim4_out_default {
				};
				pinctrl_spim4_qspi_in_default: spim4_qspi_in_default {
