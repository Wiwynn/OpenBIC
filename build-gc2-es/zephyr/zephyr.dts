				pinctrl_tach8_default: tach8_default {
				};
				pinctrl_tach9_default: tach9_default {
				};
				pinctrl_tach10_default: tach10_default {
				};
				pinctrl_tach11_default: tach11_default {
				};
				pinctrl_tach12_default: tach12_default {
				};
				pinctrl_tach13_default: tach13_default {
				};
				pinctrl_tach14_default: tach14_default {
				};
				pinctrl_tach15_default: tach15_default {
				};
				pinctrl_uart1_default: uart1_default {
					phandle = < 0x19 >;
				};
				pinctrl_uart2_default: uart2_default {
					phandle = < 0x1a >;
				};
				pinctrl_uart3_default: uart3_default {
					phandle = < 0x1b >;
				};
				pinctrl_uart4_default: uart4_default {
					phandle = < 0x1c >;
				};
				pinctrl_uart6_default: uart6_default {
					phandle = < 0x1d >;
				};
				pinctrl_uart7_default: uart7_default {
					phandle = < 0x1e >;
				};
				pinctrl_uart8_default: uart8_default {
					phandle = < 0x1f >;
				};
				pinctrl_uart9_default: uart9_default {
					phandle = < 0x20 >;
				};
				pinctrl_uart10_default: uart10_default {
					phandle = < 0x21 >;
				};
				pinctrl_uart11_default: uart11_default {
					phandle = < 0x22 >;
				};
				pinctrl_uart12_default: uart12_default {
					phandle = < 0x23 >;
				};
				pinctrl_uart13_default: uart13_default {
					phandle = < 0x24 >;
				};
				pinctrl_i3c0_default: i3c0_default {
				};
				pinctrl_i3c1_default: i3c1_default {
				};
				pinctrl_i3c2_default: i3c2_default {
				};
				pinctrl_i3c3_default: i3c3_default {
					phandle = < 0x3a >;
				};
				pinctrl_hvi3c0_default: hvi3c0_default {
					phandle = < 0x38 >;
				};
				pinctrl_hvi3c1_default: hvi3c1_default {
					phandle = < 0x39 >;
				};
				pinctrl_hvi3c2_default: hvi3c2_default {
				};
				pinctrl_hvi3c3_default: hvi3c3_default {
				};
				pinctrl_fmc_quad: fmc_quad {
					phandle = < 0x33 >;
				};
				pinctrl_spi1_quad: spi1_quad {
					phandle = < 0x34 >;
				};
				pinctrl_spi2_default: spi2_default {
					phandle = < 0x35 >;
				};
				pinctrl_spi2_cs1: spi2_cs1 {
					phandle = < 0x36 >;
				};
				pinctrl_spi2_quad: spi2_quad {
					phandle = < 0x37 >;
				};
				pinctrl_spim1_cs: spim1_cs {
				};
				pinctrl_spim1_in_default: spim1_in_default {
				};
				pinctrl_spim1_out_default: spim1_out_default {
				};
				pinctrl_spim1_qspi_in_default: spim1_qspi_in_default {
				};
				pinctrl_spim1_qspi_out_default: spim1_qspi_out_default {
				};
