  };
  rng: hwrng@7e6e2530 {
   compatible = "aspeed,hwrng";
   reg = <0x7e6e2530 0x10>;
   label = "RNG";
  };
  sbc: sbc@7e6f2000 {
   reg = <0x7e6f2000 0x100
          0x79000000 0x2400>;
