   };
   wdt3: wdt@3 {
    reg = <3>;
    aspeed,scu = <&syscon>;
    reset-mask= <0x30f1ff1 0x03fffff1>;
    label = "wdt3";
    status = "disabled";
   };
   wdt4: wdt@4 {
    reg = <4>;
    aspeed,scu = <&syscon>;
    reset-mask= <0x30f1ff1 0x03fffff1>;
    label = "wdt4";
    status = "disabled";
   };
  };
  i3c: bus@7e7a0000 {
   compatible = "simple-bus";
   #address-cells = <1>;
   #size-cells = <1>;
   ranges = <0 0x7e7a0000 0x8000>;
