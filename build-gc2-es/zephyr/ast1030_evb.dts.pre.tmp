   compatible = "aspeed,spi-controller";
   reg = <0x7e620000 0xc4>, <0x80000000 0x10000000>;
   reg-names = "ctrl_reg", "spi_mmap";
   interrupts = <39 1>;
   clocks = <&sysclk ((64) + 1)>;
   pinctrl-0 = <&pinctrl_fmc_quad>;
   num-cs = <2>;
   ast-platform = <1030>;
   ctrl-type = "bspi";
   label = "FMC";
   #address-cells = <1>;
   #size-cells = <0>;
   spi-ctrl-caps-mask = <0x000e0e0c>;
