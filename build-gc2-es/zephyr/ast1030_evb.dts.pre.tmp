&i3c {
 i3c_gr: i3c-global-regs@0 {
  compatible = "aspeed,i3c-global";
  #address-cells = <1>;
  #size-cells = <0>;
  reg = <0x0 0x100>;
  resets = <&sysrst ((0x50 << 16) | (0x54 << 8) | (7))>;
  ni3cs = <4>;
  status = "disabled";
 };
 i3c0: i3c0@2000 {
  compatible = "aspeed,i3c";
  #address-cells = <1>;
  #size-cells = <0>;
  reg = <0x2000 0x1000>;
  interrupts = <102 0>;
  resets = <&sysrst ((0x50 << 16) | (0x54 << 8) | (8))>;
  clocks = <&sysclk ((32) + 8)>;
  i2c-scl-hz = <1000000>;
  i3c-scl-hz = <12500000>;
  i3c-pp-scl-hi-period-ns = <40>;
  i3c-pp-scl-lo-period-ns = <40>;
  i3c-od-scl-hi-period-ns = <380>;
  i3c-od-scl-lo-period-ns = <620>;
  sda-tx-hold-ns = <10>;
  instance-id = <0>;
  pinctrl-0 = <&pinctrl_hvi3c0_default>;
  status = "disabled";
  label = "I3C_0";
 };
 i3c1: i3c1@3000 {
  compatible = "aspeed,i3c";
  #address-cells = <1>;
  #size-cells = <0>;
  reg = <0x3000 0x1000>;
  interrupts = <103 0>;
  resets = <&sysrst ((0x50 << 16) | (0x54 << 8) | (9))>;
  clocks = <&sysclk ((32) + 9)>;
  i2c-scl-hz = <1000000>;
  i3c-scl-hz = <12500000>;
  i3c-pp-scl-hi-period-ns = <40>;
  i3c-pp-scl-lo-period-ns = <40>;
  i3c-od-scl-hi-period-ns = <380>;
  i3c-od-scl-lo-period-ns = <620>;
  sda-tx-hold-ns = <10>;
  instance-id = <1>;
  pinctrl-0 = <&pinctrl_hvi3c1_default>;
  status = "disabled";
  label = "I3C_1";
 };
 i3c2: i3c2@4000 {
  compatible = "aspeed,i3c";
  #address-cells = <1>;
  #size-cells = <0>;
  reg = <0x4000 0x1000>;
  interrupts = <104 0>;
  resets = <&sysrst ((0x50 << 16) | (0x54 << 8) | (10))>;
  clocks = <&sysclk ((32) + 10)>;
  i2c-scl-hz = <1000000>;
  i3c-scl-hz = <12500000>;
  i3c-pp-scl-hi-period-ns = <40>;
  i3c-pp-scl-lo-period-ns = <40>;
  i3c-od-scl-hi-period-ns = <380>;
  i3c-od-scl-lo-period-ns = <620>;
  sda-tx-hold-ns = <10>;
  instance-id = <2>;
  status = "disabled";
  label = "I3C_2";
 };
 i3c3: i3c3@5000 {
  compatible = "aspeed,i3c";
  #address-cells = <1>;
  #size-cells = <0>;
  reg = <0x5000 0x1000>;
  interrupts = <105 0>;
  resets = <&sysrst ((0x50 << 16) | (0x54 << 8) | (11))>;
  clocks = <&sysclk ((32) + 11)>;
  i2c-scl-hz = <1000000>;
  i3c-scl-hz = <12500000>;
  i3c-pp-scl-hi-period-ns = <40>;
  i3c-pp-scl-lo-period-ns = <40>;
  i3c-od-scl-hi-period-ns = <380>;
  i3c-od-scl-lo-period-ns = <620>;
  sda-tx-hold-ns = <10>;
  instance-id = <3>;
  status = "disabled";
  label = "I3C_3";
 };
};
/ {
 model = "Aspeed AST1030 Evaluation board";
 compatible = "aspeed,bic-ast1030", "aspeed,ast1030";
 chosen {
  zephyr,console = &uart5;
  zephyr,shell-uart = &uart5;
  zephyr,sram = &sram0;
  zephyr,flash = &fmc_cs0;
  zephyr,entropy = &rng;
 };
};
&sram0 {
 reg = <0 ((448) * 1024)>, <0x70000 ((320) * 1024)>;
};
&uart5 {
 clock-frequency = <1846153>;
 current-speed = <115200>;
 status = "okay";
};
&adc0 {
 status = "okay";
 pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
  &pinctrl_adc2_default &pinctrl_adc3_default
  &pinctrl_adc4_default &pinctrl_adc5_default
  &pinctrl_adc6_default &pinctrl_adc7_default>;
};
&adc1 {
 status = "okay";
 pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
  &pinctrl_adc10_default &pinctrl_adc11_default
  &pinctrl_adc12_default &pinctrl_adc13_default
  &pinctrl_adc14_default &pinctrl_adc15_default>;
};
&jtag1{
 status = "okay";
};
&i2c0 {
 pinctrl-0 = <&pinctrl_i2c0_default>;
 status = "okay";
 clock-frequency = <100000>;
};
&i2c1 {
 pinctrl-0 = <&pinctrl_i2c1_default>;
 status = "okay";
 clock-frequency = <100000>;
};
&i2c2 {
 pinctrl-0 = <&pinctrl_i2c2_default>;
 clock-frequency = <1000000>;
 status = "okay";
 ipmb2: ipmb@20 {
  compatible = "aspeed,ipmb";
  reg = <0x20>;
  label = "IPMB_2";
  size = <10>;
 };
};
&i2c3 {
 pinctrl-0 = <&pinctrl_i2c3_default>;
 status = "okay";
 clock-frequency = <100000>;
};
&i2c4 {
 pinctrl-0 = <&pinctrl_i2c4_default>;
 status = "okay";
 clock-frequency = <100000>;
};
&i2c5 {
 pinctrl-0 = <&pinctrl_i2c5_default>;
 status = "okay";
 clock-frequency = <400000>;
};
&i2c6 {
 pinctrl-0 = <&pinctrl_i2c6_default>;
 clock-frequency = <1000000>;
 status = "okay";
 ipmb6: ipmb@20 {
  compatible = "aspeed,ipmb";
  reg = <0x20>;
  label = "IPMB_6";
  size = <10>;
  status = "okay";
 };
};
&i2c7 {
 pinctrl-0 = <&pinctrl_i2c7_default>;
 status = "okay";
};
&i2c8 {
 pinctrl-0 = <&pinctrl_i2c8_default>;
 status = "okay";
};
&i2c9 {
 pinctrl-0 = <&pinctrl_i2c9_default>;
 status = "okay";
};
&i3c_gr {
 status = "okay";
 pull-up-resistor-ohm = <2000>, <2000>, <2000>, <2000>, <2000>, <2000>;
};
&i3c3 {
 status = "okay";
 assigned-address = <0x11>;
 i3c-scl-hz = <5000000>;
 pinctrl-0 = <&pinctrl_i3c3_default>;
 i3c-pp-scl-hi-period-ns = <100>;
 i3c-pp-scl-lo-period-ns = <100>;
};
&espi {
 status = "okay";
 perif,dma-mode;
 perif,memcyc-src-addr = <0x98000000>;
 perif,memcyc-size = <0x10000>;
 oob,dma-mode;
 flash,dma-mode;
 flash,safs-mode = <0x2>;
};
&udc {
 status = "okay";
};
&kcs3 {
 status = "okay";
 addr = <0xca2>;
};
&uart1 {
        status = "okay";
};
&uart5 {
 current-speed = <57600>;
};
&gpio0_a_d {
 aspeed,persist-maps = <0x08000000>;
};
&snoop {
 status = "okay";
 port = <0x80>, <0x81>;
};
&fmc {
 status = "okay";
};
&fmc_cs0 {
 status = "okay";
 spi-max-buswidth = <4>;
 spi-max-frequency = <50000000>;
 partitions {
  compatible = "fixed-partitions";
  #address-cells = <1>;
  #size-cells = <1>;
  boot_partition: partition@0 {
   label = "image-0";
   reg = <0x0 0x100000>;
  };
  dfu_partition: partition@1 {
   label = "image-1";
   reg = <0x0 0x100000>;
  };
 };
};
&fmc_cs1 {
 status = "disabled";
 spi-max-buswidth = <4>;
 spi-max-frequency = <50000000>;
};
&spi1 {
 status = "okay";
};
&spi1_cs0 {
 status = "okay";
 spi-max-buswidth = <4>;
 spi-max-frequency = <50000000>;
 re-init-support;
};
&spi1_cs1 {
 status = "disabled";
 spi-max-buswidth = <4>;
 spi-max-frequency = <50000000>;
 re-init-support;
};
&spi2 {
 status = "disabled";
};
&spi2_cs0 {
 status = "disabled";
 spi-max-buswidth = <4>;
 spi-max-frequency = <50000000>;
 re-init-support;
};
&spi2_cs1 {
 status = "disabled";
 spi-max-buswidth = <4>;
 spi-max-frequency = <50000000>;
 re-init-support;
};
&wdt0 {
  status = "okay";
};
&wdt1 {
 status = "okay";
};
&wdt2 {
 status = "okay";
};
&wdt3 {
 status = "okay";
};
&wdt4 {
 status = "okay";
};
