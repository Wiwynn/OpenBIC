#define EMC1412_DEFAULT_TEMP_LSB_REG 0x29
#define EMC1412_DEFAULT_RESOLUTION 0.125
#define EMC1412_TEMP_SHIFT_BIT 5

uint8_t emc1412_read(sensor_cfg *cfg, int *reading)
{
