  command = $PRE_LINK && /opt/toolchains/cmake-3.20.0-linux-x86_64/bin/cmake -E rm -f $TARGET_FILE && /opt/toolchains/zephyr-0.12.4/arm-zephyr-eabi/bin/arm-zephyr-eabi-ar qc $TARGET_FILE $LINK_FLAGS $in && /opt/toolchains/zephyr-0.12.4/arm-zephyr-eabi/bin/arm-zephyr-eabi-ranlib $TARGET_FILE && $POST_BUILD
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /opt/toolchains/cmake-3.20.0-linux-x86_64/bin/cmake --regenerate-during-build -S/home/pablo1997/MyAllProject/ZephyrOpenbic/TestGc2Bic_0102/OpenBIC/meta-facebook/gc2-es -B/home/pablo1997/MyAllProject/ZephyrOpenbic/TestGc2Bic_0102/OpenBIC/build-gc2-es
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = /opt/toolchains/cmake-3.20.0-linux-x86_64/bin/cmake -DCONFIG=$CONFIG -P CMakeFiles/clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/pablo1997/.local/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/pablo1997/.local/bin/ninja -t targets
  description = All primary targets available:

